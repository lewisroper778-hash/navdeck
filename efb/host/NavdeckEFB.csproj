<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NavdeckEFB</AssemblyName>
    <RootNamespace>NavdeckEfb</RootNamespace>
    <ApplicationIcon>navdeck-efb.ico</ApplicationIcon>
    <Version>1.4.2</Version>
    <Product>NAVDECK EFB</Product>
    <Company>NAVDECK</Company>
    <Authors>NAVDECK</Authors>
    <Copyright>Copyright (C) 2026 NAVDECK</Copyright>
    <Description>NAVDECK EFB: electronic flight bag for flight simulators</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Fast start: pre-compiled code and no single-file extraction on launch. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="FSUIPCClientDLL" Version="3.3.16" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>

  <!-- The Discord webhook for journey logs comes from the build environment (GitHub secret
       EFB_DISCORD_WEBHOOK), so it never appears in the source code. -->
  <ItemGroup Condition="'$(EFB_DISCORD_WEBHOOK)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DiscordWebhook</_Parameter1>
      <_Parameter2>$(EFB_DISCORD_WEBHOOK)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/runways.csv" LogicalName="NavdeckEfb.Data.runways.csv" />
    <Content Include="../manuals/**/*.pdf" Link="manuals/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="../web/**/*" Link="web/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
