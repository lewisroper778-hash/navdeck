<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NavdeckDesktop</AssemblyName>
    <RootNamespace>NavdeckLink</RootNamespace>
    <ApplicationIcon>navdeck.ico</ApplicationIcon>
    <Version>1.3.1</Version>
    <Product>NAVDECK Desktop</Product>
    <Company>NAVDECK</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSUIPCClientDLL" Version="3.3.16" />
  <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" /></ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/runways.csv" LogicalName="NavdeckLink.Data.runways.csv" />
    <Content Include="../ui/map.html" Link="desktop-map/map.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="../ui/workspace.html" Link="desktop-map/workspace.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="../ui/flight.html" Link="desktop-map/flight.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="../ui/touchdown.html" Link="desktop-map/touchdown.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="../../frontend/public/favicon.png" Link="desktop-map/navdeck-website-logo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="../ui/vendor/**/*" Link="desktop-map/vendor/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>